// prisma/schema.prisma
// 로컬 개발: SQLite / 프로덕션: provider를 postgresql로 교체

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── 역할 ────────────────────────────────────────────────

enum Role {
  PARTNER  // 협력사
  AGENT    // 견적 담당자
  SALES    // 영업 담당자
}

// ── 사용자 ──────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  company   String?  // 협력사명 (PARTNER인 경우)
  password  String   // SHA-256 해시 (개발용 Credentials provider)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids              Bid[] @relation("BidPartner")
  assignedAgentBids Bid[] @relation("BidAgent")
  assignedSalesBids Bid[] @relation("BidSales")
  versions          QuoteVersion[]
}

// ── 비딩 ────────────────────────────────────────────────

enum BidStatus {
  OPEN
  SELECTED
  CONFIRMED
  CLOSED
}

model Bid {
  id          String    @id @default(cuid())
  bidCode     String    @unique
  title       String
  region      String
  duration    Int       // 여행 기간 (박수)
  travelStart DateTime
  travelEnd   DateTime
  status      BidStatus @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  partner   User    @relation("BidPartner", fields: [partnerId], references: [id])
  partnerId String
  agent     User?   @relation("BidAgent", fields: [agentId], references: [id])
  agentId   String?
  sales     User?   @relation("BidSales", fields: [salesId], references: [id])
  salesId   String?
  quotes    Quote[]

  @@index([bidCode])
  @@index([region])
  @@index([agentId])
  @@index([salesId])
}

// ── 견적 ────────────────────────────────────────────────

model Quote {
  id            String   @id @default(cuid())
  quoteCode     String   @unique  // 예: QC00687628001
  latestVersion String   @default("v1.0")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bid      Bid            @relation(fields: [bidId], references: [id])
  bidId    String
  versions QuoteVersion[]

  @@index([quoteCode])
}

// ── 견적 버전 (절대 UPDATE 금지 — INSERT only) ────────────

model QuoteVersion {
  id           String   @id @default(cuid())
  versionNo    String   // "v1.0", "v1.1" 형식
  changeReason String?
  savedAt      DateTime @default(now())

  itineraryData String  // JSON 직렬화 (SQLite)
  quoteData     String  // JSON 직렬화 (SQLite)

  quote       Quote  @relation(fields: [quoteId], references: [id])
  quoteId     String
  savedBy     User   @relation(fields: [savedById], references: [id])
  savedById   String
  savedByRole Role

  @@unique([quoteId, versionNo])
  @@index([quoteId])
}

// ── 패키지 상품 템플릿 ──────────────────────────────────

model PackageTemplate {
  id          String   @id @default(cuid())
  productCode String   @unique
  title       String
  region      String
  duration    Int
  itinerary   String   // JSON 직렬화 (SQLite)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([region, duration])
}
