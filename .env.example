# .env.example
# 복사: cp .env.example .env.local

# ── Database ──────────────────────────────────────────
# 로컬 개발: SQLite (DB 서버 없이 즉시 시작)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# 프로덕션: 아래로 교체
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host:5432/tour_editor"

# ── NextAuth ──────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-minimum-32-chars-here-ok"

# ── MCP: 하나투어 상품 데이터 (쉼표로 구분하면 여러 URL을 순차 시도) ─
USE_MOCK_MCP="true"
# 예: "http://10.225.18.50:8080/mcp" (Streamable HTTP 단일 엔드포인트)
HANATOUR_MCP_URL="http://10.225.18.50:8080/mcp"
HANATOUR_MCP_TOKEN=""
HANATOUR_MCP_REQUEST_TIMEOUT_MS="30000"
HANATOUR_MCP_TOOL_CALL_TIMEOUT_MS="60000"

# ── Mock 설정 (1차 개발용) ────────────────────────────
USE_MOCK_FLIGHTS="true"
USE_MOCK_COST_REF="true"

# ── 팝업 허용 Origin ──────────────────────────────────
ALLOWED_PARENT_ORIGINS="https://hub.hanatour.com,http://localhost:8080"

# ── OpenAI: 일정 AI 파싱 ───────────────────────────────
# 필수: 실제 키 입력
OPENAI_API_KEY=""
# 선택: 모델/엔드포인트/타임아웃
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_PARSE_TIMEOUT_MS="30000"
