@startuml TourEditorClassDiagram
title Tour Editor - 도메인 모델과 서비스 클래스 다이어그램

skinparam ClassAttributeIconSize 0
skinparam ClassBackgroundColor #F7F9FC
skinparam ClassBorderColor #2F3A4A
skinparam EnumBackgroundColor #FFF4D6
skinparam PackageBorderColor #8A94A6

package "Prisma 모델" {
  enum Role {
    PARTNER
    AGENT
    SALES
  }

  enum BidStatus {
    OPEN
    SELECTED
    CONFIRMED
    CLOSED
  }

  class User <<model>> {
    +String id
    +String email
    +String name
    +Role role
    +String? company
    +String password
    +DateTime createdAt
    +DateTime updatedAt
  }

  class Bid <<model>> {
    +String id
    +String bidCode
    +String title
    +String region
    +Int duration
    +DateTime travelStart
    +DateTime travelEnd
    +BidStatus status
    +String partnerId
    +DateTime createdAt
    +DateTime updatedAt
  }

  class Quote <<model>> {
    +String id
    +String quoteCode
    +String latestVersion
    +String bidId
    +DateTime createdAt
    +DateTime updatedAt
  }

  class QuoteVersion <<model>> {
    +String id
    +String versionNo
    +String? changeReason
    +DateTime savedAt
    +String itineraryData
    +String quoteData
    +String quoteId
    +String savedById
    +Role savedByRole
  }

  class PackageTemplate <<model>> {
    +String id
    +String productCode
    +String title
    +String region
    +Int duration
    +String itinerary
    +Boolean isActive
    +DateTime createdAt
  }
}

package "공유 타입" {
  class ItineraryData <<type>> {
    +header
    +overview
    +basics
    +days: DaySchedule[]
  }

  class DaySchedule <<type>> {
    +number dayNo
    +string date
    +ScheduleItem[] items
  }

  class ScheduleItem <<type>> {
    +string id
    +ScheduleItemType type
    +string? region
    +string? transport
    +string? time
    +string content
    +string? detail
    +meal?
    +string? hotel
  }

  class QuoteData <<type>> {
    +header
    +QuoteExchangeRate[]? exchangeRates
    +QuoteItem[] items
    +summary
  }

  class QuoteItem <<type>> {
    +string id
    +QuoteCategory category
    +string region
    +string date
    +string description
    +number quantity
    +number unitPrice
    +string? currencyRateId
    +number subtotal
    +number? refPrice
  }
}

package "도메인 서비스" {
  class CreateVersionService <<함수>> {
    +createVersion(input): CreatedVersion
  }

  class VersionNumberService <<함수>> {
    +generateVersionNo(current): string
  }

  class VersionDiffService <<함수>> {
    +diffVersions(left, right)
  }

  class ItineraryPolicyService <<함수>> {
    +enforceAccommodationPolicy(data): ItineraryData
  }

  class ItineraryParserService <<함수>> {
    +parseItineraryWithDiagnostics(input): ItineraryParseResult
    +parseItineraryByAi(input): ItineraryData
    +parseFallbackFromRaw(rawText): ItineraryData
    +normalizeAiResult(raw, title): ItineraryData
  }

  class SpreadsheetTextService <<함수>> {
    +spreadsheetRowsToText(rows): string
    +normalizeSpreadsheetCell(value): string
  }

  class ParseUploadRoute <<API>> {
    +POST(request): Response
    +spreadsheetToText(file): string
    +pdfToText(file): string
    +hwpxToText(file): string
  }

  class QuoteCurrencyService <<함수>> {
    +getQuoteExchangeRates(data)
    +recalculateQuoteData(input): QuoteData
  }

  class McpMappingService <<함수>> {
    +mapMcpProductToItinerary(payload, code): ItineraryData
  }

  class ExcelService <<함수>> {
    +generateItineraryWorkbook(data)
    +generateCostWorkbook(data)
    +generateExcelFilename(input): string
  }
}

package "클라이언트 상태" {
  class EditorStore <<zustand>> {
    +ItineraryData? itinerary
    +QuoteData? quote
    +boolean isDirty
    +loadFromProduct(itinerary)
    +setItinerary(itinerary)
    +setQuote(quote)
    +markSaved()
    +initFromVersion(itinerary, quote)
  }
}

User "1" -- "0..*" Bid : 협력사 담당
User "1" -- "0..*" QuoteVersion : 저장자
Bid "1" -- "0..*" Quote : 견적 보유
Quote "1" -- "0..*" QuoteVersion : 버전 보유

ItineraryData "1" *-- "1..*" DaySchedule
DaySchedule "1" *-- "0..*" ScheduleItem
QuoteData "1" *-- "0..*" QuoteItem

CreateVersionService ..> Quote : latestVersion 조회 및 갱신
CreateVersionService ..> QuoteVersion : snapshot INSERT
CreateVersionService ..> VersionNumberService
EditorStore ..> ItineraryData
EditorStore ..> QuoteData
McpMappingService ..> ItineraryData
ParseUploadRoute ..> ItineraryParserService
ParseUploadRoute ..> SpreadsheetTextService
ItineraryParserService ..> ItineraryData
ItineraryParserService ..> ItineraryPolicyService
QuoteCurrencyService ..> QuoteData
ExcelService ..> ItineraryData
ExcelService ..> QuoteData

note right of QuoteVersion
  append-only 버전 레코드입니다.
  기존 QuoteVersion row는 수정하지 않습니다.
  SQLite 개발 환경에서는 itineraryData와 quoteData를
  JSON 문자열로 저장합니다.
end note

note bottom of EditorStore
  클라이언트 draft 상태와 DB 저장 snapshot은 분리합니다.
  저장 이후의 기준 데이터는 DB의 QuoteVersion입니다.
  상품/파일/직접 입력으로 일정을 불러오면
  isDirty=true가 되어 미저장 변경으로 취급합니다.
end note

note right of ItineraryParserService
  파일 업로드 파싱은 AI 후보와 기본 파서 후보를 함께 평가합니다.
  이미지형 PDF는 OCR fallback 텍스트를 원문으로 사용합니다.
  표 형태 입력에서는 원문 식사/호텔 열을 권위값으로 사용합니다.
  지원 형식은 .xlsx, .pdf, .hwpx, text 계열입니다.
  .xls와 .hwp는 변환 안내 오류를 반환합니다.
end note

@enduml
