@startuml TourEditorFlowchart
title Tour Editor - 주요 사용자 흐름 플로우차트

skinparam ActivityBackgroundColor #F7F9FC
skinparam ActivityBorderColor #2F3A4A
skinparam DiamondBackgroundColor #FFF4D6
skinparam DiamondBorderColor #A46A00
skinparam ArrowColor #2B3A42

start

:허브가 quoteNo와 role을 포함해\n에디터 팝업을 연다;
: /editor/popup 렌더링;
:GET /api/editor/init 호출;

if (JWT 세션이 유효한가?) then (예)
  :quoteCode로 Quote 조회;
else (아니오)
  :401 반환;
  :초기화 오류 표시;
  stop
endif

if (Quote가 존재하는가?) then (예)
  :최신 QuoteVersion 조회;
  if (최신 버전이 존재하는가?) then (예)
    :itineraryData와 quoteData 파싱;
    :에디터 store 초기화;
  else (아니오)
    :빈 에디터 상태 초기화;
    :상품 검색 팝업 열기;
  endif
else (아니오)
  :quote null 반환;
  :상품 검색 팝업 열기;
endif

repeat
  :사용자가 일정표 또는 견적서를 편집한다;
  :Zustand store 업데이트;
  :isDirty true 설정;
  :브라우저에 draft 임시 저장;

  if (상품을 검색하는가?) then (예)
    :GET /api/mcp/products/:code 호출;
    if (USE_MOCK_MCP이고 mock이 존재하는가?) then (예)
      :products.json 로드;
    else (아니오)
      :MCP 상품 API 호출;
      if (MCP 조회 성공?) then (예)
        :MCP payload 사용;
      else (아니오)
        if (mock fallback 존재?) then (예)
          :mock fallback 사용;
        else (아니오)
          :상품 조회 오류 표시;
        endif
      endif
    endif
    :상품 payload를 ItineraryData로 매핑;
    :에디터 store의 일정표 교체;
  endif

  if (일정 원문을 AI로 파싱하는가?) then (예)
    :POST /api/itinerary/parse 호출;
    :AI가 일정 원문 파싱;
    :일정 데이터 정규화;
    :파싱 결과를 에디터 상태에 반영;
  endif

  if (버전 이력을 여는가?) then (예)
    :GET /api/quotes/:id/versions 호출;
    :버전 목록 표시;
    if (과거 버전을 선택하는가?) then (예)
      :GET /api/quotes/:id/versions/:version 호출;
      :읽기 전용 버전 상세 열기;
    endif
    if (버전을 비교하는가?) then (예)
      :GET /api/quotes/:id/versions/diff 호출;
      :DiffViewer 표시;
    endif
  endif

  if (Excel을 다운로드하는가?) then (예)
    :/api/quotes/:id/export 호출\n(type=itinerary 또는 cost);
    :src/lib/excel에서 workbook 생성;
    :.xlsx 다운로드;
  endif

repeat while (계속 편집하는가?) is (예)

if (저장하는가?) then (예)
  if (배정 UserID가 일치하는가?) then (예)
    :itineraryData, quoteData,\nchangeReason, expectedVersion 제출;
    :createVersion() 호출;
    :Quote.latestVersion 조회;
    if (expectedVersion이 일치하는가?) then (예)
      :다음 버전 번호 생성;
      :QuoteVersion snapshot INSERT;
      :Quote.latestVersion 포인터 UPDATE;
      :로컬 draft 삭제;
      :store를 저장 완료 상태로 변경;
      :postMessage SAVE_COMPLETE 전송;
      :저장 완료 표시;
    else (아니오)
      :409 VERSION_CONFLICT 반환;
      :최신 버전 새로고침 안내;
    endif
  else (아니오)
    :403 반환;
    :권한 없음 표시;
    stop
  endif
else (아니오)
  if (isDirty인가?) then (예)
    :닫기 전 미저장 변경 경고;
  else (아니오)
    :팝업 안전 종료;
  endif
endif

stop

@enduml
