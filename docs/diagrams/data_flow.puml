@startuml TourEditorDataFlow
title Tour Editor - 데이터 흐름 다이어그램

left to right direction
skinparam ComponentStyle rectangle
skinparam DatabaseBackgroundColor #E7F5FF
skinparam ComponentBackgroundColor #FFF8E7
skinparam ArrowColor #2B3A42
skinparam PackageBorderColor #8A94A6

actor "사용자" as User

package "외부 시스템" {
  component "허브 부모 창" as Parent
  component "MCP 상품 API" as MCP
  component "OpenAI 호환 API" as AI
}

package "Tour Editor 클라이언트" {
  component "팝업 라우트\n/editor/popup" as Popup
  component "EditorShell" as EditorShell
  component "에디터 컴포넌트\n일정표, 견적서, 버전, 미리보기" as Components
  component "SearchPopup\n상품코드/파일/직접입력" as SearchPopup
  component "Zustand Store\nitinerary, quote, isDirty" as Store
  component "TanStack Query\n서버 상태" as Query
  component "localStorage 임시저장\nuseAutoSave" as Draft
}

package "Next.js 서버" {
  component "API Routes\nsrc/app/api/**" as API
  component "NextAuth\nJWT 세션" as Auth
  component "버전 서비스\ncreateVersion" as Version
  component "일정 파서\nparseItineraryWithDiagnostics\n(src/lib/itinerary/aiParser)" as Parser
  component "스프레드시트→텍스트\nspreadsheetRowsToText" as SheetText
  component "일정 정책/표시\npolicy, display" as Itinerary
  component "견적 서비스\ncurrency, generate" as QuoteSvc
  component "MCP 매핑\nmapSaleProductToItinerary" as Mapper
  component "Excel 서비스\nworkbook 생성" as Excel
  component "설정\nsrc/lib/config.ts" as Config
}

database "SQLite dev.db\nPrisma 경유" as DB {
}

package "로컬 Mock 데이터" {
  component "products.json" as ProductMock
  component "flights.json" as FlightMock
  component "cost-reference.json" as CostMock
}

User --> Parent : "견적 상세에서 팝업 열기"
Parent --> Popup : "quoteNo, role URL 파라미터 전달"
Popup --> EditorShell : "클라이언트 shell 렌더링"
EditorShell --> Query : "usePopupInit(quoteNo)"
Query --> API : "GET /api/editor/init"
API --> Auth : "토큰 검증"
API --> DB : "Quote + 최신 QuoteVersion 조회"
DB --> API : "snapshot JSON 문자열"
API --> Query : "타입화된 JSON 응답"
Query --> Store : "initFromVersion"
Store --> Components : "편집 중 draft 상태 제공"
Components --> Store : "사용자 일정/견적 수정"
Store --> Draft : "임시 자동 저장"

Components --> SearchPopup : "일정 불러오기"
SearchPopup --> API : "GET /api/mcp/products/:code"
API --> Config : "USE_MOCK_MCP, MCP URL/token 확인"
API --> ProductMock : "mock 상품 조회"
API --> MCP : "설정에 따라 실제 상품 조회"
MCP --> API : "상품 원본 payload"
ProductMock --> API : "mock 또는 fallback 상품"
API --> Mapper : "ItineraryData로 정규화"
Mapper --> API : "ItineraryData"
API --> SearchPopup : "상품 일정표 데이터"
SearchPopup --> Store : "loadFromProduct\nisDirty=true"

SearchPopup --> API : "POST /api/itinerary/parse\nfile/text/title (?debug=1 선택)"
API --> Config : "OPENAI_* 설정 확인"
API --> SheetText : ".xlsx 시트 스코어·다중 시트 선택\n(일정표 시트 우선, 최대 8)\n셀 표시값→텍스트, HH:mm 보정"
SheetText --> API : "[sheet:이름] 구획 포함 rawText"
API --> AI : "이미지형 PDF OCR\n텍스트 부족 시"
AI --> API : "OCR 텍스트"
API --> Parser : ".pdf/OCR/.hwpx/text\nrawText + title"
Parser --> Parser : "전처리 preprocess\n증거(evidence) 수집"
Parser --> AI : "분석 + JSON 변환\n(API key 있을 때)"
AI --> Parser : "ai 후보 ItineraryData"
Parser --> Parser : "결정적 후보\ndeterministic-tabular /\ndeterministic-narrative"
Parser --> Parser : "후보별 품질·필드 커버리지 스코어\n표 경계 시 표 항목 권위 병합"
Parser --> Parser : "선택: ai vs tabular vs quality\n+ 식사/숙박 원문 보정"
Parser --> API : "ItineraryData + diagnostics\n(candidateScores 등)"
API --> SearchPopup : "파싱 결과"
SearchPopup --> Store : "loadFromProduct\nisDirty=true"

Components --> API : "POST /api/quotes/:id/versions"
API --> Auth : "서버 사이드 역할 확인"
API --> Version : "createVersion"
Version --> DB : "Quote.latestVersion 조회"
Version --> DB : "QuoteVersion INSERT"
Version --> DB : "Quote.latestVersion UPDATE"
DB --> Version : "생성된 버전"
Version --> API : "versionNo, savedAt"
API --> Components : "201 Created"
Components --> Parent : "postMessage SAVE_COMPLETE"

Components --> API : "GET /api/quotes/:id/versions"
API --> Auth : "권한 및 배정 UserID 확인"
API --> DB : "QuoteVersion 목록 조회"
DB --> API : "version summaries 또는 오류"
API --> Components : "버전 이력/오류 상태"

Components --> API : "GET /api/quotes/:id/versions/:version"
API --> DB : "QuoteVersion snapshot 조회"
API --> Components : "읽기 전용 미리보기 데이터"
Components --> Components : "본문 입력/일정 불러오기/항공 조회 비활성화"

Components --> API : "GET/POST /api/quotes/:id/export"
API --> DB : "필요 시 저장된 버전 조회"
API --> QuoteSvc : "견적/통화 데이터 정규화"
API --> Excel : "일정표 또는 견적서 workbook 생성"
Excel --> API : "xlsx buffer"
API --> Components : "xlsx 다운로드 응답"

API --> FlightMock : "USE_MOCK_FLIGHTS=true일 때 항공 mock"
API --> CostMock : "USE_MOCK_COST_REF=true일 때 원가 mock"

@enduml
