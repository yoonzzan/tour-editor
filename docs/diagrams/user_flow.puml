@startuml UserFlow
title Tour Editor - 사용자 흐름

skinparam ActivityBackgroundColor #F9F9F9
skinparam ActivityBorderColor #333333
skinparam ArrowColor #666666

start

:부모 창(견적 상세)에서 "에디터 열기" 클릭;
:URL 파라미터 quoteNo, role과 함께 팝업 실행;

if (세션 유효?) then (아니오)
  :/login?callbackUrl=현재 팝업 URL로 이동;
  :로그인 성공 후 원래 팝업 URL로 복귀;
else (예)
endif

if (세션 role과 URL role이 일치하는가?) then (아니오)
  :권한 없음 화면 표시;
  :다른 계정으로 로그인 버튼 제공;
  stop
else (예)
endif

:GET /api/editor/init?quoteNo=... 호출;
:Quote의 Bid 배정 UserID와 현재 UserID 검증;

if (배정 UserID 일치?) then (아니오)
  :권한 없음 표시;
  stop
else (예)
  :최신 QuoteVersion snapshot 로드;
  :에디터 초기화;
endif

if (role?) then (PARTNER)
  :PARTNER UI 적용\n항공 조회 숨김, 일정 불러오기/저장 가능;
elseif (AGENT)
  :AGENT UI 적용\n항공 조회/일정 불러오기/저장 가능;
else (SALES)
  :SALES UI 적용\n항공 조회/일정 불러오기/최종 조정/저장 가능;
endif

partition "편집 프로세스" {
  split
    :일정표 탭;
    if (데이터 없음?) then (예)
      :검색/불러오기 팝업;
      :상품코드 MCP / 파일 첨부 / 직접 입력 선택;
      if (파일 첨부?) then (예)
        :.xlsx / PDF / HWPX / 텍스트 파싱;
        :AI 후보와 기본 파서 후보 품질 비교;
        :표 원문 식사/호텔 값 보정;
      endif
      :기초 일정 데이터 생성;
    endif
    :일정 항목 추가/수정/삭제/D&D;
  split again
    :견적서 탭;
    :항목별 단가 및 수량 입력;
    :합계 및 세금 자동 계산;
  end split
}

:미리보기 또는 Excel 다운로드;

if (과거 버전 미리보기?) then (예)
  :버전 이력에서 snapshot 로드;
  :읽기 전용 화면 표시;
  :본문 입력/일정 불러오기/항공 조회 비활성화;
endif

if (저장 클릭?) then (예)
  :변경 사유 입력;
  :POST /api/quotes/:id/versions;
  :새 QuoteVersion snapshot INSERT;
  :Quote.latestVersion 포인터 UPDATE;
  :부모 창에 SAVE_COMPLETE postMessage 전달;
  :저장 완료 표시;
else (닫기)
  if (변경사항 있음?) then (예)
    :저장하지 않은 변경 확인 팝업;
  endif
endif

if (닫기 클릭?) then (예)
  :부모 창에 EDITOR_CLOSED postMessage 전달;
  :팝업 종료 시도;
endif

stop

@enduml
